{
  "name": "fleet-audit",
  "about": "Health and configuration of one machine. Run it on every node.",
  "needs": {
    "cores": 1
  },
  "args": [
    {
      "name": "check_path",
      "type": "text",
      "default": "/",
      "description": "Which filesystem to check"
    },
    {
      "name": "min_disk",
      "type": "int",
      "default": 15,
      "min": 0,
      "max": 100,
      "description": "Percent of the checked filesystem that must be free"
    },
    {
      "name": "min_mem",
      "type": "int",
      "default": 10,
      "min": 0,
      "max": 100,
      "description": "Percent of memory that must be available"
    }
  ]
}
