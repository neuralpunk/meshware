---
source: crates/mesh-core/src/deploy.rs
expression: system.reset_script()
---
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then systemctl stop meshnode >/dev/null 2>&1 || true; fi
if [ -e '/var/lib/meshware'/mesh/genesis.json ]; then
mv '/var/lib/meshware' '/var/lib/meshware'.replaced-$(date +%Y%m%d-%H%M%S)
echo mw.reset=moved
else
echo mw.reset=none
fi
